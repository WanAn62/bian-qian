<Window x:Class="Notelet.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置提醒" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Card.Brush}"
        Foreground="{DynamicResource Text.Brush}"
        FontFamily="{DynamicResource BaseFont.FontFamily}"
        FontSize="13"
        BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="&#xE823;" FontFamily="{DynamicResource IconFont.FontFamily}" FontSize="15"
                           Foreground="{DynamicResource Accent.Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="设置提醒" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="&#xE8BB;" Style="{StaticResource CloseBtn}" Width="28" Height="28"
                    HorizontalAlignment="Right" Margin="0,0,8,0" Click="Cancel_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="18,4,18,16">
            <TextBlock Text="快速选择" Style="{StaticResource SideLabel}"/>
            <WrapPanel Margin="0,0,0,4">
                <Button Content="30 分钟后" Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,6"
                        Margin="0,0,8,8" Click="Quick_Click" Tag="30m"/>
                <Button Content="1 小时后" Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,6"
                        Margin="0,0,8,8" Click="Quick_Click" Tag="1h"/>
                <Button Content="3 小时后" Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,6"
                        Margin="0,0,8,8" Click="Quick_Click" Tag="3h"/>
                <Button Content="明天 09:00" Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,6"
                        Click="Quick_Click" Tag="tomorrow"/>
            </WrapPanel>

            <TextBlock Text="自定义时间" Style="{StaticResource SideLabel}" Margin="0,8,0,7"/>
            <DockPanel>
                <DatePicker x:Name="RemindDate" DockPanel.Dock="Left" Width="130"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="HourBox" Width="62" Height="28"/>
                    <TextBlock Text=":" FontSize="14" FontWeight="Bold" Margin="4,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MinuteBox" Width="62" Height="28" Margin="0,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <Grid Margin="0,18,0,0">
                <Button x:Name="ClearBtn" Content="清除提醒" Style="{StaticResource FlatBtn}" FontSize="12"
                        Padding="10,6" HorizontalAlignment="Left" Click="Clear_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource DlgBtn}" MinWidth="80" Height="30" Click="Cancel_Click"/>
                    <Button Content="确定" Style="{StaticResource DlgBtnAccent}" MinWidth="80" Height="30"
                            Margin="8,0,0,0" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
