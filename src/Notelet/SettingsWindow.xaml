<Window x:Class="Notelet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg.Brush}"
        Foreground="{DynamicResource Text.Brush}"
        FontFamily="{DynamicResource BaseFont.FontFamily}"
        FontSize="{DynamicResource BaseFontSize.Double}"
        BorderBrush="{DynamicResource Border.Brush}" BorderThickness="1">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="4" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="{DynamicResource Accent.Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="设置" FontSize="15" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="&#xE8BB;" Style="{StaticResource CloseBtn}" Width="32" Height="32"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                    Click="Close_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <ScrollViewer Grid.Row="1" MaxHeight="560" VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
            <StackPanel>

                <!-- 通用 -->
                <TextBlock Text="通用" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Sub.Brush}" Margin="4,10,0,8"/>
                <Border Background="{DynamicResource Field.Brush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,6">
                    <StackPanel>
                        <CheckBox x:Name="AutostartSwitch" Content="开机自启" Style="{StaticResource ToggleSwitch}"
                                  Click="Autostart_Click" Margin="0,0,0,14" ToolTip="登录 Windows 后自动运行简签"/>
                        <CheckBox x:Name="TraySwitch" Content="关闭窗口时最小化到托盘" Style="{StaticResource ToggleSwitch}"
                                  Click="Tray_Click" Margin="0,0,0,14"/>
                        <CheckBox x:Name="FollowSwitch" Content="跟随系统深浅色" Style="{StaticResource ToggleSwitch}"
                                  Click="Follow_Click" Margin="0,0,0,14"
                                  ToolTip="开启后随系统在「暖纸」与「墨夜」之间自动切换"/>
                        <CheckBox x:Name="TopmostSwitch" Content="窗口置顶" Style="{StaticResource ToggleSwitch}"
                                  Click="Topmost_Click"/>
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Sub.Brush}" Margin="4,12,0,8"/>
                <Border Background="{DynamicResource Field.Brush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,6">
                    <DockPanel>
                        <Button Content="打开美化面板" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,6"
                                Foreground="{DynamicResource Accent.Brush}" Click="OpenTheme_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ThemeNameText" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="在主窗口的调色板面板里可自定义颜色、圆角、字号、卡片宽度、字体与云母 / 亚克力背景"
                                       FontSize="11.5" Foreground="{DynamicResource Sub.Brush}" Margin="0,3,8,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 快捷键 -->
                <TextBlock Text="快捷键" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Sub.Brush}" Margin="4,12,0,8"/>
                <Border Background="{DynamicResource Field.Brush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,6">
                    <StackPanel x:Name="HotkeyList"/>
                </Border>

                <!-- 存储与备份 -->
                <TextBlock Text="存储与备份" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Sub.Brush}" Margin="4,12,0,8"/>
                <Border Background="{DynamicResource Field.Brush}" CornerRadius="12" Padding="18,14" Margin="0,0,0,6">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="打开" VerticalAlignment="Center"
                                    Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,5" Click="OpenData_Click"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="数据目录" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DataPathText" FontSize="11.5" Foreground="{DynamicResource Sub.Brush}"
                                           Margin="0,3,8,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="打开备份" Style="{StaticResource FlatBtn}" FontSize="12" Padding="10,5"
                                        Click="OpenBackups_Click"/>
                                <Button x:Name="CleanBackupsBtn" Content="清理旧备份" Style="{StaticResource FlatBtn}" FontSize="12"
                                        Padding="10,5" Margin="8,0,0,0" Click="CleanBackups_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="BackupCountText" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="每次启动自动备份一次，默认保留最近 10 份" FontSize="11.5"
                                           Foreground="{DynamicResource Sub.Brush}" Margin="0,3,8,0"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Text="数据仅保存在本机，不上传任何内容" FontSize="11.5"
                                   Foreground="{DynamicResource Sub.Brush}" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="导出全部便签" Style="{StaticResource FlatBtn}" FontSize="12"
                                    Padding="10,5" Click="ExportAll_Click"/>
                            <Button Content="导入便签备份" Style="{StaticResource FlatBtn}" FontSize="12"
                                    Padding="10,5" Margin="8,0,0,0" Click="ImportAll_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <TextBlock Text="关于" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Sub.Brush}" Margin="4,12,0,8"/>
                <Border Background="{DynamicResource Field.Brush}" CornerRadius="12" Padding="18,14">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="26" Height="26" Fill="{DynamicResource Accent.Brush}" VerticalAlignment="Center"/>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource Sub.Brush}" Margin="0,3,0,0">
                                <Run Text="开源 "/>
                                <Hyperlink NavigateUri="https://github.com/WanAn62/bian-qian"
                                           RequestNavigate="GitHub_Link" Foreground="{DynamicResource Accent.Brush}">
                                    github.com/WanAn62/bian-qian
                                </Hyperlink>
                                <Run Text=" · MIT"/>
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <TextBlock Text="所有设置即时生效" FontSize="11" Foreground="{DynamicResource Sub.Brush}"
                           HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
