<Application x:Class="Notelet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- 运行时由 ThemeService 动态覆盖；此处为默认值（暖纸主题） -->
        <SolidColorBrush x:Key="Bg.Brush" Color="#F7F3EC"/>
        <SolidColorBrush x:Key="Card.Brush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Text.Brush" Color="#3D3A34"/>
        <SolidColorBrush x:Key="Sub.Brush" Color="#8A857C"/>
        <SolidColorBrush x:Key="Accent.Brush" Color="#D97E5F"/>
        <SolidColorBrush x:Key="Field.Brush" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="Border.Brush" Color="#1A000000"/>

        <CornerRadius x:Key="Radius.CornerRadius">14</CornerRadius>
        <sys:Double x:Key="BaseFontSize.Double">14</sys:Double>
        <sys:Double x:Key="TitleSize.Double">15.5</sys:Double>
        <sys:Double x:Key="BodyMax.Double">126</sys:Double>
        <sys:Double x:Key="CardWidth.Double">244</sys:Double>

        <FontFamily x:Key="BaseFont.FontFamily">Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFont.FontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <DropShadowEffect x:Key="CardHover.Shadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.20" Color="#000000"/>

    </Application.Resources>
</Application>
